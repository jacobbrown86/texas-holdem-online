# Copy this file to `.env.local` and fill in your project's values.
# Both are safe to ship to the browser — the publishable/anon key is public by
# design; RLS + Edge Functions are what protect the data.
#
# Find them in the Supabase dashboard: Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# Use the new PUBLISHABLE key (sb_publishable_...) or the legacy anon public key.
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Web Push public key (VAPID). Optional until you wire up notifications.
# Must match VAPID_PUBLIC_KEY in the Edge Function secrets.
VITE_VAPID_PUBLIC_KEY=

# NEVER put the service_role / secret key here. It bypasses RLS and must live
# only in the Edge Function secrets (supabase secrets set), never in the client.
